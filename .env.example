# Backend Environment Variables Template (Render / Production)

# PostgreSQL Database Connection
ConnectionStrings__DefaultConnection=Host=YOUR_DB_HOST;Database=Seatly;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Port=5432

# Supabase Auth Configuration
Supabase__Authority=https://YOUR_SUPABASE_PROJECT_ID.supabase.co/auth/v1
Supabase__ValidIssuer=https://YOUR_SUPABASE_PROJECT_ID.supabase.co/auth/v1
Supabase__ValidAudience=authenticated

# Optional Email / Notification Service Key
Email__ApiKey=YOUR_EMAIL_API_KEY
Email__SenderEmail=noreply@seatly.app
